NEXT_PUBLIC_APP_NAME=CodeArea
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Supabase project: codearea (replace the password and pooler host from Connect).
SUPABASE_URL=https://vkngvliowkiacrpevfga.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
DATABASE_URL=postgresql://postgres.vkngvliowkiacrpevfga:your_database_password@your_pooler_host:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

APP_TIMEZONE=Asia/Bangkok
APP_DATA_DIR=./data

# Resource-heavy utilities run separately and are reached directly by URL.
PISTON_URL=http://your-windows-host:2000
PISTON_LANGUAGES=javascript:18.15.0,python:3.10.0,c++:10.2.0,java:15.0.2
PISTON_RUN_TIMEOUT_MS=10000

OLLAMA_URL=http://your-windows-host:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_VERSION=nomic-embed-text-v1

# Sign up with this email, then rerun npm run db:seed to promote it to admin.
ADMIN_EMAIL=admin@codearea.local
