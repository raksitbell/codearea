NEXT_PUBLIC_APP_NAME=CodeArea
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host-based development connects through compose.dev.yaml on localhost.
DATABASE_URL=postgres://codearea:codearea@127.0.0.1:5432/codearea
SESSION_COOKIE_NAME=codearea_session
SESSION_TTL_DAYS=14
APP_TIMEZONE=Asia/Bangkok
APP_DATA_DIR=./data

# Resource-heavy utilities run separately on the Windows desktop.
PISTON_URL=http://192.168.1.50:2000
PISTON_LANGUAGES=javascript:18.15.0,python:3.10.0,c++:10.2.0,java:15.0.2
PISTON_RUN_TIMEOUT_MS=10000

OLLAMA_URL=http://192.168.1.50:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_VERSION=nomic-embed-text-v1

# Optional bootstrap administrator created by npm run db:seed.
ADMIN_EMAIL=admin@codearea.local
ADMIN_PASSWORD=change-me-for-local-development
